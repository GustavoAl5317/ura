# Flow Guard API como serviço (antes rodava com nohup, sem voltar após reboot).
#   sudo cp flow-guard-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now flow-guard-api
[Unit]
Description=Flow Guard API (NetFlow)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=flow
WorkingDirectory=/home/flow/flow-ntop/backend
# "+" = roda como root mesmo com User=flow. Falha no firewall = API não sobe.
ExecStartPre=+/usr/local/sbin/flow-guard-firewall.sh
ExecStart=/home/flow/flow-ntop/backend/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flow-guard-api

[Install]
WantedBy=multi-user.target
